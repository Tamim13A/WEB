        <!-- User Roles Legend -->
        <mxCell id="roles" value="User Roles & Access\n\n👑 Admin: Full system access\n• User/Property/Inquiry management\n• Approve/Reject properties\n• System statistics\n\n🏢 Agent: Property owner\n• CRUD own properties\n• Respond to inquiries\n• Upload images\n\n👤 Customer: Buyer/Tenant\n• Browse & search properties\n• Save favourites\n• Submit inquiries\n• View inquiry history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#757575;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="350" height="250" as="geometry"/>
        </mxCell>
        
        <!-- Data Flow Legend -->
        <mxCell id="dataflow" value="Request-Response Flow\n\n1. Browser → HTTP Request → Web Server\n2. index.php boots application\n3. Router matches URL → Controller\n4. Middleware: Auth • CSRF • Role\n5. Controller calls Model\n6. Model → PDO Prepared Statement → MySQL\n7. Database returns result set\n8. Model returns data to Controller\n9. Controller → View (HTML) or JSON Response\n10. Response → Security Headers → Browser\n\n🔒 Security at every layer:\n• Prepared Statements (SQLi)\n• htmlspecialchars (XSS)\n• password_hash (Argon2id)\n• session_regenerate_id (Fixation)\n• CSRF Tokens (CSRF)\n• RBAC Middleware (AuthZ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#757575;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="400" height="300" as="geometry"/>
        </mxCell>
        
        <!-- Tech Stack -->
        <mxCell id="techstack" value="Technology Stack\n\nFrontend: HTML5, CSS3, JavaScript (ES6+)\nBackend: PHP 8.1+ (MVC - No Framework)\nDatabase: MySQL 8.0+ (PDO)\nAPI: JSON REST + Fetch API\nAuth: Sessions + Argon2id\nSecurity: CSP, CSRF, RBAC\nServer: Apache/Nginx + mod_rewrite\n\nAssignment Requirements:\n✅ 5+ Functional Pages\n✅ 3+ Related Tables (6 tables)\n✅ CRUD on 2+ Entities\n✅ Prepared Statements\n✅ Server-side Validation\n✅ 3 Threat Analyses\n✅ JSON API + Fetch\n✅ Session Hardening (2+)\n✅ PHP MVC Implementation\n✅ ER & Architecture Diagrams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="450" width="350" height="300" as="geometry"/>
        </mxCell>
        
